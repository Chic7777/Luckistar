page {
  min-height: 100%;
  color: #273047;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(circle at 16% 6%, rgba(126, 141, 232, 0.22), rgba(126, 141, 232, 0) 52%),
    radial-gradient(circle at 84% 22%, rgba(243, 201, 95, 0.16), rgba(243, 201, 95, 0) 46%),
    radial-gradient(circle at 46% 96%, rgba(126, 216, 213, 0.22), rgba(126, 216, 213, 0) 58%),
    linear-gradient(135deg, #fbfcff 0%, #f3fbfb 38%, #f4f1ff 72%, #fff4ee 100%);
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 900;
  color: #26304a;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #2c3550;
}

.eyebrow {
  color: #6870c9;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.muted {
  color: #6d7288;
  font-size: 26rpx;
  line-height: 1.72;
}

.card {
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.74);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.52), 0 18rpx 46rpx rgba(34, 45, 86, 0.12);
  box-sizing: border-box;
}

.soft-card {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.56);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42), 0 12rpx 30rpx rgba(34, 45, 86, 0.08);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #5e6bd1, #43b8bf 58%, #efb65b);
  box-shadow: 0 16rpx 32rpx rgba(83, 108, 197, 0.22);
}

.btn-secondary {
  color: #414a68;
  border: 2rpx solid rgba(96, 108, 174, 0.18);
  background: rgba(255, 255, 255, 0.78);
}

.btn-ghost {
  color: #52607f;
  background: rgba(255, 255, 255, 0.46);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #59627f;
  font-size: 22rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.68);
}

.safe-note {
  margin-top: 28rpx;
  color: rgba(70, 78, 105, 0.72);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
