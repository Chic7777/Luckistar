.detail-page {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-card {
  position: relative;
  padding: 38rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  text-align: center;
}

.share-mini {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #5b6482;
  font-size: 22rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.78);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
}

.tag-row-left {
  justify-content: flex-start;
}

.quote-card {
  width: 100%;
  padding: 22rpx;
  box-sizing: border-box;
  color: #56617f;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-panel {
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.panel-title {
  color: #2f3955;
  font-size: 24rpx;
  font-weight: 900;
}

.panel-text {
  color: #56617f;
  font-size: 26rpx;
  line-height: 1.75;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.info-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.info-label {
  color: #7a8094;
  font-size: 20rpx;
  font-weight: 800;
}

.info-value {
  color: #303952;
  font-size: 26rpx;
  font-weight: 900;
}

.inline-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
}

.inline-label {
  color: #7a8094;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.inline-value {
  color: #3f4966;
  font-size: 24rpx;
  font-weight: 900;
}

.advice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.advice-item {
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.42);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.advice-title {
  color: #2c3550;
  font-size: 22rpx;
  font-weight: 900;
}

.advice-text {
  color: #56617f;
  font-size: 24rpx;
  line-height: 1.7;
  font-weight: 800;
}
