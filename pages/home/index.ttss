.home-page {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.home-top {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.home-top-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
}

.home-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reset-link,
.mini-btn {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #56617f;
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.62);
}

.avatar-container {
  position: relative;
  width: 100%;
  height: 400rpx; /* 缩短高度，让玩偶和表格紧凑排列 */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.personality-board {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.personality-item {
  background: rgba(255, 255, 255, 0.5);
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.p-label {
  font-size: 20rpx;
  color: #7b8198;
  font-weight: 800;
}

.p-value {
  font-size: 24rpx;
  color: #3f4966;
  font-weight: 900;
  text-align: left;
}

.avatar-container luckistar-avatar {
  position: relative;
  z-index: 5;
  transform: scale(1.2); /* 保持玩偶的视觉主体地位 */
}

/* 移除旧的浮动标签样式 */
.floating-tags, .floating-tag {
  display: none;
}

.natal-stage {
  position: relative;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  text-align: center;
  background: transparent;
  border: none;
  box-shadow: none;
}

.corner-action {
  position: absolute;
  top: -10rpx;
  right: 10rpx;
  z-index: 10;
  width: 90rpx;
  height: 90rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ffe49a 0%, #f3c95f 56%, #e7b74c 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(243, 201, 95, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

.radial-tags {
  display: none; /* 隐藏旧的底部标签栏 */
}

.trait-tag {
  max-width: 310rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.68);
}

.trait-label {
  color: #7b8198;
  font-size: 20rpx;
  font-weight: 800;
}

.trait-value {
  color: #3f4966;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 900;
}

.natal-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #2d3550;
}

.mini-link {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #5d6784;
  font-size: 22rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.62);
}

.daily-overview,
.daily-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.daily-overview .section-title {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 30rpx;
}

.charm-draw-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  overflow: hidden;
}

.charm-card-inner {
  min-height: 310rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 35%, rgba(255, 246, 176, 0.92), rgba(255, 255, 255, 0.28) 34%, rgba(126, 216, 213, 0.36) 70%),
    linear-gradient(135deg, rgba(126, 141, 232, 0.82), rgba(240, 199, 107, 0.74));
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.55), 0 18rpx 44rpx rgba(92, 102, 160, 0.16);
}

.is-flipping .charm-card-inner {
  transform: scale(0.98) rotateY(12deg);
}

.is-revealed .charm-card-inner {
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.68), 0 0 48rpx rgba(243, 201, 95, 0.46);
}

.charm-card-face {
  width: 100%;
  min-height: 280rpx;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  color: #ffffff;
  text-align: center;
}

.charm-symbol {
  font-size: 82rpx;
  line-height: 1;
  text-shadow: 0 0 24rpx rgba(255, 255, 255, 0.9);
}

.charm-hint {
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 900;
}

.charm-subhint {
  max-width: 520rpx;
  font-size: 23rpx;
  line-height: 1.7;
  opacity: 0.9;
}

.charm-result {
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.charm-name {
  font-size: 44rpx;
  font-weight: 900;
  text-shadow: 0 4rpx 18rpx rgba(77, 86, 135, 0.22);
}

.charm-desc {
  max-width: 560rpx;
  font-size: 27rpx;
  line-height: 1.65;
}

.charm-advice {
  max-width: 560rpx;
  font-size: 24rpx;
  line-height: 1.65;
  opacity: 0.95;
}

.charm-actions {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
}

.charm-actions button {
  min-height: 60rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #52607f;
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.82);
}

.daily-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.daily-head > view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.daily-date, .task-status-tip {
  align-self: flex-start;
  white-space: nowrap;
  font-size: 22rpx;
  color: #7a8094;
  font-weight: 800;
}

.daily-head-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  margin-top: -10rpx;
  margin-right: -6rpx;
}

.share-star-btn {
  width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ffe49a 0%, #f3c95f 56%, #e7b74c 100%);
  color: #fff;
  font-size: 18rpx;
  font-weight: 900;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  border: none;
  margin: 0;
  box-shadow: 0 12rpx 28rpx rgba(243, 201, 95, 0.24), inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-item {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.task-item.is-selected {
  background: linear-gradient(135deg, rgba(232, 250, 244, 0.96), rgba(255, 246, 199, 0.88));
  box-shadow: inset 0 0 0 2rpx rgba(126, 216, 213, 0.42);
}

.task-item.is-completed {
  background: linear-gradient(135deg, rgba(240, 255, 243, 0.98), rgba(247, 245, 255, 0.9));
  box-shadow: inset 0 0 0 2rpx rgba(94, 107, 209, 0.18);
}

.task-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-title {
  color: #2c3550;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.task-desc {
  color: #69718c;
  font-size: 23rpx;
  line-height: 1.6;
}

.task-state text {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #5f6884;
  font-size: 20rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.76);
}

.task-footer {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.task-footer-title {
  color: #2d3550;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 900;
}

.task-action {
  width: 100%;
}

.luck-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.luck-item {
  min-height: 104rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.62);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.luck-grid text:first-child {
  color: #7c8296;
  font-size: 21rpx;
}

.luck-grid text:last-child {
  color: #303952;
  font-size: 25rpx;
  font-weight: 900;
}

.archive-card {
  padding: 34rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* 左对齐 */
  gap: 16rpx;
}

.archive-actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 10rpx;
}

.archive-actions button {
  flex: 1; /* 均匀等分 */
  min-height: 80rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(96, 108, 174, 0.15);
  color: #414a68;
  font-size: 24rpx;
  font-weight: 800;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  padding: 36rpx;
  background: rgba(38, 48, 74, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 100%;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

textarea {
  min-height: 210rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  color: #273047;
  font-size: 27rpx;
  line-height: 1.65;
  background: rgba(255, 255, 255, 0.76);
  box-sizing: border-box;
}

.checkbox-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #52607f;
  font-size: 26rpx;
  font-weight: 800;
}
