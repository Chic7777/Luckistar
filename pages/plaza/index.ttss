.plaza-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 增加整体间距 */
  padding: 30rpx;
}

.page-head {
  position: relative; /* 为右上角按钮定位 */
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  padding-right: 120rpx; /* 为星星按钮腾出空间 */
  min-height: 120rpx;
}

.page-head .page-title {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  line-height: 1.4;
}

.mini-btn {
  position: absolute;
  top: -10rpx;
  right: 0;
  width: 90rpx;
  height: 90rpx;
  min-height: 90rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #ffe49a 0%, #f3c95f 56%, #e7b74c 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(243, 201, 95, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

.visit-card {
  padding: 28rpx; /* 增加内边距 */
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
}

.visit-title {
  display: block;
  color: #303952;
  font-size: 29rpx;
  font-weight: 900;
}

.masonry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.post-card {
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 16rpx;
}

.post-author {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.post-author text:first-child {
  color: #2e3853;
  font-size: 23rpx;
  font-weight: 900;
}

.post-author text:last-child {
  color: #7a8094;
  font-size: 19rpx;
}

.post-image {
  position: relative;
  height: 260rpx;
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #ffffff;
  overflow: hidden;
}

.post-image::after {
  position: absolute;
  content: "";
  inset: 26rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 28rpx;
}

.image-spark {
  position: absolute;
  right: 24rpx;
  top: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 40rpx;
}

.cover-chip-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cover-chip {
  min-height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.22);
}

.cover-chip.is-soft {
  background: rgba(255, 255, 255, 0.14);
}

.cover-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cover-title {
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
  text-shadow: 0 6rpx 18rpx rgba(55, 63, 100, 0.25);
}

.cover-note {
  max-width: 250rpx;
  font-size: 22rpx;
  line-height: 1.55;
  text-shadow: 0 4rpx 16rpx rgba(55, 63, 100, 0.22);
}

.image-tall {
  height: 330rpx;
}

.image-mid {
  height: 280rpx;
}

.image-short {
  height: 235rpx;
}

.visual-sun {
  background: radial-gradient(circle at 42% 34%, rgba(255, 247, 191, 0.96), rgba(255, 180, 116, 0.78) 42%, rgba(126, 141, 232, 0.62));
}

.visual-moon {
  background: radial-gradient(circle at 56% 28%, rgba(255, 255, 255, 0.96), rgba(126, 216, 213, 0.62) 35%, rgba(94, 107, 209, 0.74));
}

.visual-flower {
  background: radial-gradient(circle at 50% 42%, rgba(255, 224, 232, 0.96), rgba(126, 216, 213, 0.58), rgba(243, 201, 95, 0.7));
}

.visual-star {
  background: radial-gradient(circle at 50% 32%, rgba(255, 246, 176, 0.96), rgba(255, 255, 255, 0.22) 30%, rgba(126, 141, 232, 0.78));
}

.visual-rainbow {
  background: linear-gradient(135deg, #7f8de8, #6bd2cd 48%, #f0c76b);
}

.visual-card {
  background: linear-gradient(145deg, rgba(101, 198, 155, 0.92), rgba(126, 216, 213, 0.8), rgba(255, 247, 198, 0.92));
}

.visual-wardrobe {
  background: linear-gradient(145deg, rgba(137, 211, 174, 0.92), rgba(233, 246, 223, 0.88), rgba(255, 247, 198, 0.92));
}

.visual-food {
  background: linear-gradient(145deg, rgba(255, 229, 190, 0.92), rgba(255, 245, 224, 0.94), rgba(143, 221, 196, 0.84));
}

.visual-cosmos {
  background: linear-gradient(145deg, rgba(111, 136, 220, 0.92), rgba(150, 223, 218, 0.78), rgba(252, 239, 188, 0.9));
}

.visual-book {
  background: linear-gradient(145deg, rgba(130, 205, 177, 0.92), rgba(246, 248, 232, 0.92), rgba(220, 237, 213, 0.9));
}

.visual-friend {
  background: linear-gradient(145deg, rgba(255, 220, 214, 0.92), rgba(172, 231, 219, 0.8), rgba(255, 247, 198, 0.9));
}

.visual-note {
  background: linear-gradient(145deg, rgba(136, 211, 169, 0.9), rgba(217, 239, 230, 0.94), rgba(250, 242, 214, 0.9));
}

.post-body {
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.post-title {
  color: #2f3955;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 900;
}

.post-content {
  color: #46516f;
  font-size: 22rpx;
  line-height: 1.55;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag-line text {
  min-height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  color: #65708e;
  font-size: 18rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.7);
}

.post-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  padding: 0 16rpx 18rpx;
}

.post-foot text {
  color: #5d6683;
  font-size: 21rpx;
  font-weight: 900;
}

.post-foot button {
  min-height: 50rpx;
  min-width: 92rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #52607f;
  font-size: 19rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.7);
}
